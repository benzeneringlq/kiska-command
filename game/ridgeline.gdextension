[configuration]
entry_symbol = "ridgeline_library_init"
compatibility_minimum = "4.5"
reloadable = true

[libraries]
macos.debug = "res://bin/libridgeline.dylib"
macos.release = "res://bin/libridgeline.dylib"
linux.debug.x86_64 = "res://bin/libridgeline.so"
linux.release.x86_64 = "res://bin/libridgeline.so"
windows.debug.x86_64 = "res://bin/libridgeline.dll"
windows.release.x86_64 = "res://bin/libridgeline.dll"
